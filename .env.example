# 3DKenji local development environment

# FastAPI / SQLAlchemy database URL used by the backend app.
DATABASE_URL=postgresql+psycopg://kenji:kenji@db:5432/kenji

# MCP Postgres server URL. Must be a plain postgres/postgresql URL.
MCP_POSTGRES_URL=postgresql://kenji:kenji@db:5432/kenji

# Filesystem and logs
STORAGE_ROOT=/data/storage
LOG_DIR=/data/logs

# Security
SECRET_KEY=dev-secret-key

# OAuth / OIDC is now configured from the admin settings page and stored in the database.
# Keep SECRET_KEY stable after first boot because it is used to decrypt stored OAuth client secrets.
# OIDC_* environment variables are no longer used at runtime.
