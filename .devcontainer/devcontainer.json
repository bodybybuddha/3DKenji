{
  "workspaceFolder": "/workspace",
  "name": "3D Kenji Devcontainer",
  "dockerComposeFile": "docker-compose.yml",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "service": "backend",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "editor.wordWrap": "on",
        "editor.formatOnSave": true,
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "/workspace/src"
        ]
      }
    }
  },
  "postCreateCommand": "bash -c 'cd /workspace && uv venv --python 3.11 --clear && VIRTUAL_ENV=/workspace/.venv /workspace/.venv/bin/pip install -e .'",
  "postStartCommand": "bash -c 'source /workspace/.venv/bin/activate && cd /workspace && uvicorn src.backend.main:app --host 0.0.0.0 --port 8000'"
}